  "author": "SIMP Team",
  "summary": "Manages the rngd entropy-gathering daemon (rng-tools)",
  "license": "Apache-2.0",
  "source": "https://github.com/simp/pupmod-simp-rngd",
  "project_page": "https://github.com/simp/pupmod-simp-rngd",
